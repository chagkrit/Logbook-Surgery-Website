VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
VITE_APP_URL=https://logbook-surgery-website.vercel.app

# Server-only Microsoft Graph settings for the departmental OneDrive account.
# Configure these in Vercel. Never prefix secrets with VITE_ or expose them to the browser.
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-app-client-id
MICROSOFT_CLIENT_SECRET=your-server-only-client-secret
# Set for a personal Microsoft account or delegated work/school account.
# If present, the backup uses /me/drive. Keep this token server-only.
MICROSOFT_REFRESH_TOKEN=optional-delegated-refresh-token
# Required only for application-only Microsoft 365 organizational accounts.
ONEDRIVE_ACCOUNT_ID=logbook-department@example.ac.th
